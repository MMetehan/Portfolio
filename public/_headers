# Netlify _headers file for performance optimization
# https://docs.netlify.com/routing/headers/

# Global security and performance headers
/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  
  # Performance and Caching
  X-DNS-Prefetch-Control: on
  
  # Content Security Policy (adjust domains as needed)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; object-src 'none'; base-uri 'self'; form-action 'self';

/index.html
  Cache-Control: public, max-age=300, s-maxage=300
  X-Content-Type-Options: nosniff

/*.html
  Cache-Control: public, max-age=60, s-maxage=60
  X-Content-Type-Options: nosniff

/static/*
  Cache-Control: public, max-age=31536000, immutable

*.js
  Cache-Control: public, max-age=31536000, immutable

*.css
  Cache-Control: public, max-age=31536000, immutable

# Images - Long cache
*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

*.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

*.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

*.svg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Type: image/svg+xml; charset=utf-8

*.ico
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Fonts - Long cache
*.woff
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Type: font/woff

*.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Type: font/woff2

*.ttf
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Type: font/ttf

*.otf
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Content-Type: font/otf

# Manifest and service worker - Medium cache
/manifest.json
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Content-Type: application/manifest+json; charset=utf-8

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Content-Type: application/javascript; charset=utf-8

# Sitemap and robots - Medium cache
/sitemap.xml
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Content-Type: text/plain; charset=utf-8

# PDF files - Long cache
*.pdf
  Cache-Control: public, max-age=2592000
  X-Content-Type-Options: nosniff
  Content-Type: application/pdf

# Blog pages - Short cache for dynamic content
/blog/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# API responses (if any) - No cache
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Preload critical resources for better performance
/
  Link: </my.jpeg>; rel=preload; as=image
  Link: </manifest.json>; rel=preload; as=fetch; crossorigin=anonymous
  Link: <https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap>; rel=preload; as=style
  Link: <https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap>; rel=preload; as=style

# JSON files - Medium cache
*.json
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Content-Type: application/json; charset=utf-8

# Source maps - No cache in production (should be blocked by robots.txt)
*.map
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

# Compression for text-based files (Netlify handles this automatically, but good to specify)
*.html
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.css
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.js
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.json
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.xml
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.txt
  Content-Encoding: gzip
  Vary: Accept-Encoding
